{#- Campos personalizados: el correo con sus campos (*|NOMBRE|*, *|SALDO|*) y
    al lado el mismo correo como le llega a una persona, con sus datos. Palabras
    de content.py y colores de las clases .art-*, como los demás dibujos de
    Features. -#}
{% set w = item.words %}
<svg class="tour__art" viewBox="0 0 480 270" preserveAspectRatio="xMidYMid slice"
     role="img" aria-label="{{ item.alt }}" focusable="false">
  <defs>
    <filter id="ff-drop" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" class="art-drop"/>
    </filter>
  </defs>
  <rect class="art-stage" width="480" height="270"/>

  {#- los dos correos: el de los campos y el de Ana. Lo que cambia va en azul. -#}
  {% for left, name, balance in [(34, w.name_tag, w.balance_tag), (250, w.name, w.balance)] %}
  <g filter="url(#ff-drop)">
    <rect class="art-card" x="{{ left }}" y="62" width="196" height="146" rx="16"/>
  </g>
  <rect class="art-blue-soft" x="{{ left }}" y="62" width="196" height="14" rx="7" opacity=".55"/>
  <text class="art-ink" x="{{ left + 18 }}" y="110" font-size="15" font-weight="700">{{ w.greet }}<tspan class="art-blue">{{ name }}</tspan></text>
  <text class="art-ink" x="{{ left + 18 }}" y="138" font-size="12.5" font-weight="600">{{ w.balance_label }}<tspan class="art-blue" font-weight="700">{{ balance }}</tspan></text>
  <rect class="art-line" x="{{ left + 18 }}" y="158" width="150" height="7" rx="3.5"/>
  <rect class="art-line" x="{{ left + 18 }}" y="174" width="112" height="7" rx="3.5"/>
  {% endfor %}

</svg>
