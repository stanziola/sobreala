{#- Envío inmediato o programado: las dos formas de mandar una campaña, ahora o a
    una fecha y hora, con la segunda marcada. Palabras de content.py y colores de
    las clases .art-*, como los demás dibujos de Features. -#}
{% set w = item.words %}
<svg class="tour__art" viewBox="0 0 480 270" preserveAspectRatio="xMidYMid slice"
     role="img" aria-label="{{ item.alt }}" focusable="false">
  <defs>
    <filter id="fs-drop" x="-20%" y="-40%" width="140%" height="190%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" class="art-drop"/>
    </filter>
  </defs>
  <rect class="art-stage" width="480" height="270"/>

  {#- ahora: sin marcar -#}
  <g filter="url(#fs-drop)">
    <rect class="art-card" x="104" y="52" width="272" height="56" rx="14"/>
  </g>
  <circle class="art-s-edge" cx="134" cy="80" r="9" fill="none" stroke-width="2"/>
  <text class="art-ink" x="156" y="85" font-size="15" font-weight="600">{{ w.now }}</text>

  {#- programado: marcado, con su día y su hora -#}
  <g filter="url(#fs-drop)">
    <rect class="art-card art-s-blue" x="104" y="124" width="272" height="90" rx="14"
          stroke-width="2"/>
  </g>
  <circle class="art-s-blue" cx="134" cy="152" r="9" fill="none" stroke-width="2"/>
  <circle class="art-blue" cx="134" cy="152" r="4.5"/>
  <text class="art-ink" x="156" y="157" font-size="15" font-weight="700">{{ w.later }}</text>
  <rect class="art-blue-soft" x="156" y="173" width="18" height="17" rx="4"/>
  <rect class="art-blue" x="156" y="173" width="18" height="5.5" rx="2.5"/>
  <text class="art-ink" x="184" y="186" font-size="13" opacity=".78">{{ w.when }}</text>
</svg>
