{#- Evita problemas de spam: los correos salen del portátil en fila hacia la
    bandeja, que los recibe con su ganchito verde, y uno se desvía y cae a la
    papelera con su equis roja. Sigue el encuadre de la imagen de referencia,
    sin las palabras que llevaba («Inbox», «Spam»): la bandeja, la papelera y
    sus insignias ya lo dicen. Los colores salen de las clases .art-*. -#}
{%- macro envelope(x, y, turn=0, scale=1, face="art-paper", dim=false) -%}
<g transform="translate({{ x }} {{ y }}) rotate({{ turn }}) scale({{ scale }})">
  <rect class="{{ face }} art-s-shade" x="-16" y="-12" width="32" height="24" rx="3.5" stroke-width="1.3"/>
  {% if dim %}<rect x="-16" y="-12" width="32" height="24" rx="3.5" fill="black" fill-opacity=".1"/>{% endif %}
  <path class="art-s-shade" d="m-14.5-10 14.5 11 14.5-11" fill="none" stroke-width="1.5" stroke-linejoin="round"/>
  <path class="art-s-shade" d="m-14 10.5 10-8M14 10.5l-10-8" fill="none" stroke-width="1" opacity=".7"/>
</g>
{%- endmacro %}
<svg class="trouble__draw" viewBox="0 0 480 300" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="as-clip"><rect width="480" height="300" rx="20"/></clipPath>
    <radialGradient id="as-glow" cx="45%" cy="40%" r="70%">
      <stop offset="0" class="art-glow"/>
      <stop offset="1" class="art-glow" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="as-sheen" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="white" stop-opacity=".45"/>
      <stop offset=".6" stop-color="white" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="as-shade" x1="0" y1="0" x2="0" y2="1">
      <stop offset=".35" stop-color="black" stop-opacity="0"/>
      <stop offset="1" stop-color="black" stop-opacity=".22"/>
    </linearGradient>
    <filter id="as-drop" x="-30%" y="-30%" width="160%" height="180%">
      <feDropShadow dx="0" dy="6" stdDeviation="6" class="art-drop"/>
    </filter>
    <path id="as-lid" d="M22 92a8 8 0 0 1 8-8l106-7a8 8 0 0 1 8 8l4 100a6 6 0 0 1-6 6l-112 6a6 6 0 0 1-6-6Z"/>
    <path id="as-bin" d="M258 204h100l-5 72a9 9 0 0 1-9 8h-72a9 9 0 0 1-9-8Z"/>
    <path id="as-tray" d="M290 100h128v46a8 8 0 0 1-8 8H298a8 8 0 0 1-8-8Z"/>
  </defs>

  <g clip-path="url(#as-clip)">
    <rect class="art-stage" width="480" height="300"/>
    <rect width="480" height="300" fill="url(#as-glow)"/>

    {#- el camino que se desvía, por debajo de todo -#}
    <path class="art-s-dash" d="M150 166c30-28 78-34 110-4" fill="none" stroke-width="3"
          stroke-dasharray="6 7" stroke-linecap="round"/>
    <path class="art-s-dash" d="m250 150 12 13-17 3" fill="none" stroke-width="3"
          stroke-linecap="round" stroke-linejoin="round"/>

    {#- el portátil azul, con un correo en pantalla -#}
    <g filter="url(#as-drop)">
      <path class="art-blue-deep" d="M18 196l130-8 72 24-160 10Z"/>
    </g>
    <path class="art-blue" d="M40 199l100-6 50 16-122 7Z"/>
    <path d="M40 199l100-6 50 16-122 7Z" fill="url(#as-sheen)"/>
    <path class="art-blue-deep" d="M60 222l160-10v6l-160 10Z"/>
    <path d="M60 222l160-10v6l-160 10Z" fill="url(#as-shade)"/>
    <g filter="url(#as-drop)">
      <use href="#as-lid" class="art-blue-deep"/>
    </g>
    <path class="art-blue" d="M32 98a5 5 0 0 1 5-5l94-6a5 5 0 0 1 5 5l3 88a4 4 0 0 1-4 4l-98 5a4 4 0 0 1-4-4Z"/>
    <path d="M32 98a5 5 0 0 1 5-5l94-6a5 5 0 0 1 5 5l3 88a4 4 0 0 1-4 4l-98 5a4 4 0 0 1-4-4Z" fill="url(#as-sheen)"/>
    <g filter="url(#as-drop)">
      {{ envelope(88, 142, -3, 1.9) }}
    </g>

    {#- la bandeja, con lo que ya le llegó -#}
    <path class="art-blue-soft" d="M296 86h116l14 14H282Z"/>
    <g filter="url(#as-drop)">
      {{ envelope(334, 70, -6, 1.45) }}
      {{ envelope(388, 84, 4, 1.35) }}
    </g>
    <g filter="url(#as-drop)">
      <use href="#as-tray" class="art-card"/>
    </g>
    <use href="#as-tray" fill="url(#as-shade)" opacity=".45"/>
    <path class="art-blue" d="M418 100l14-14v46a8 8 0 0 1-3 6l-11 10Z"/>
    <path d="M418 100l14-14v46a8 8 0 0 1-3 6l-11 10Z" fill="url(#as-sheen)"/>
    <rect class="art-blue-soft" x="290" y="100" width="128" height="6" rx="3"/>

    {#- la fila de correos que sale hacia la bandeja -#}
    <g filter="url(#as-drop)">
      {{ envelope(158, 118, -16, 1.05) }}
      {{ envelope(198, 96, -10, 1.1) }}
      {{ envelope(246, 80, -4, 1.15) }}
      {{ envelope(292, 74, 2, 1.2) }}
    </g>

    {#- el ganchito verde -#}
    <g filter="url(#as-drop)">
      <circle class="art-green" cx="424" cy="52" r="16"/>
    </g>
    <circle cx="424" cy="52" r="16" fill="url(#as-sheen)"/>
    <path class="art-s-paper" d="m416 52 6 6 11-12" fill="none" stroke-width="3.6"
          stroke-linecap="round" stroke-linejoin="round"/>

    {#- el que se pierde, y la papelera -#}
    <g filter="url(#as-drop)">
      {{ envelope(280, 172, 26, 1.2, dim=true) }}
    </g>
    <path class="art-navy" d="M262 196h92l4 8H258Z"/>
    <path d="M262 196h92l4 8H258Z" fill="black" fill-opacity=".3"/>
    {{ envelope(318, 204, -24, 1.15, dim=true) }}
    <g filter="url(#as-drop)">
      <use href="#as-bin" class="art-navy"/>
    </g>
    <use href="#as-bin" fill="url(#as-sheen)" opacity=".5"/>
    <use href="#as-bin" fill="url(#as-shade)"/>
    <rect class="art-navy" x="256" y="202" width="104" height="5" rx="2.5"/>
    <rect x="256" y="202" width="104" height="5" rx="2.5" fill="white" fill-opacity=".18"/>

    {#- la equis roja -#}
    <g filter="url(#as-drop)">
      <circle class="art-red" cx="358" cy="190" r="15"/>
    </g>
    <circle cx="358" cy="190" r="15" fill="url(#as-sheen)"/>
    <path class="art-s-paper" d="m352 184 12 12m0-12-12 12" fill="none" stroke-width="3.6" stroke-linecap="round"/>
  </g>
</svg>
