{# One inline icon per feature card. Stroked, 24x24, inherits currentColor. #}
{% macro feature_icon(name) -%}
<svg class="icon icon--feature" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
{%- if name == 'contacts' %}
  <path d="M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19"/>
  <circle cx="10" cy="8" r="3.2"/><path d="M17.5 11.5h3M19 10v3"/>
{%- elif name == 'campaign' %}
  <rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="m3.5 6.5 8.5 6 8.5-6"/>
  <path d="M7 16h4"/>
{%- elif name == 'schedule' %}
  <circle cx="12" cy="12.5" r="7.5"/><path d="M12 8.5v4.2l2.8 1.8"/><path d="M9 2.5h6"/>
{%- elif name == 'chart' %}
  <path d="M4 20V4"/><path d="M4 20h16"/><path d="M8 17v-5"/><path d="M13 17V7"/><path d="M18 17v-8"/>
{%- elif name == 'shield' %}
  <path d="M12 3.2 5 6v5.5c0 4 2.9 7.5 7 8.8 4.1-1.3 7-4.8 7-8.8V6Z"/><path d="m9.3 11.8 2 2 3.6-3.8"/>
{%- elif name == 'flag' %}
  <path d="M5.5 21V4"/><path d="M5.5 5h11l-1.8 3.4L16.5 12h-11Z"/>
{%- else %}
  <circle cx="12" cy="12" r="8"/>
{%- endif %}
</svg>
{%- endmacro %}
