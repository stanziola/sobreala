<section class="section section--alt" id="preguntas" aria-labelledby="faq-title">
  <div class="shell shell--narrow">
    <p class="eyebrow">{{ faq.eyebrow }}</p>
    <h2 class="section__title" id="faq-title">{{ faq.title }}</h2>
    <ul class="faq">
      {% for item in faq['items'] %}
      <li class="faq__item">
        <details{% if loop.first %} open{% endif %}>
          <summary class="faq__q">
            <span>{{ item.q }}</span>
            <span class="faq__mark" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{{ item.a }}</p></div>
        </details>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
