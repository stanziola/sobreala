{#- Administra tus contactos: un archivo CSV que entra a la lista, con sus tres
    filas y el contador. Palabras de content.py y colores de las clases .art-*,
    como los demás dibujos de Features; lo que cuenta va en el centro. -#}
{% set w = item.words %}
<svg class="tour__art" viewBox="0 0 480 270" preserveAspectRatio="xMidYMid slice"
     role="img" aria-label="{{ item.alt }}" focusable="false">
  <defs>
    <filter id="fc-drop" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" class="art-drop"/>
    </filter>
  </defs>
  <rect class="art-stage" width="480" height="270"/>

  <g transform="translate(8 0)">
  {#- el archivo, con la esquina doblada, su sello y unas filas -#}
  <g filter="url(#fc-drop)">
    <path class="art-card" d="M46 62h70l28 28v106a12 12 0 0 1-12 12H46a12 12 0 0 1-12-12V74a12 12 0 0 1 12-12z"/>
  </g>
  <path class="art-card-edge" d="M116 62v16a12 12 0 0 0 12 12h16z"/>
  <rect class="art-green" x="50" y="98" width="48" height="22" rx="6"/>
  <text x="74" y="113.5" text-anchor="middle" font-size="11.5" font-weight="800" fill="white">{{ w.badge }}</text>
  {% for top, width in [(134, 78), (150, 62), (166, 74), (182, 54)] %}
  <rect class="art-line" x="50" y="{{ top }}" width="{{ width }}" height="7" rx="3.5"/>
  {% endfor %}
  <text class="art-ink" x="89" y="232" text-anchor="middle" font-size="12" opacity=".72">{{ w.file }}</text>


  </g>

  <g transform="translate(-18 0)">
  {#- la lista: su título, el contador y tres filas -#}
  <g filter="url(#fc-drop)">
    <rect class="art-card" x="204" y="44" width="252" height="182" rx="16"/>
  </g>
  <text class="art-ink" x="224" y="76" font-size="14" font-weight="700">{{ w.title }}</text>
  <text x="436" y="76" text-anchor="end" font-weight="800">
    <tspan class="art-blue" font-size="16">{{ w.count }}</tspan><tspan class="art-ink" font-size="12.5" font-weight="600" opacity=".72">{{ w.limit }}</tspan>
  </text>
  {% for email in w.emails %}
  {% set top = 92 + loop.index0 * 42 %}
  <rect class="art-card-edge" x="224" y="{{ top }}" width="212" height="1.5"/>
  <circle class="art-blue" cx="238" cy="{{ top + 21 }}" r="11"/>
  <circle class="art-card" cx="238" cy="{{ top + 18 }}" r="3.8"/>
  <path class="art-card" d="M231.6 {{ top + 28 }}a6.4 5 0 0 1 12.8 0z"/>
  <text class="art-ink" x="258" y="{{ top + 25.5 }}" font-size="12.5" font-weight="600">{{ email }}</text>
  {% endfor %}
  </g>
</svg>
