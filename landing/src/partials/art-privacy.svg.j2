{#- Protege la privacidad de tus contactos: el correo bajo llave en el centro y
    cada persona en su propio aro, unidas por líneas que no pasan por las demás.
    Sigue el encuadre de la imagen de referencia, con sus seis personas: pelo
    oscuro y camisa azul, media melena y blusa amarilla, gafas y camisa marino,
    pelo largo y blusa morada, pelo pelirrojo y camisa verde, melena y blusa
    rosa. Sin rasgos en la cara, como en la referencia. -#}
{%- macro person(x, y, shirt, hair="art-hair", style="short", glasses=false) -%}
<g transform="translate({{ x }} {{ y }})">
  <g filter="url(#ap-drop)"><circle class="art-card" r="34"/></g>
  <circle class="art-stage" r="28"/>
  <g clip-path="url(#ap-face)">
    {% if style == "long" %}<path class="{{ hair }}" d="M-15-2c-3-16 4-26 15-26s18 10 15 26l3 30h-36Z"/>{% endif %}
    {% if style == "bob" %}<path class="{{ hair }}" d="M-15 8c-5-20 3-32 15-32s20 12 15 32Z"/>{% endif %}
    <path class="{{ shirt }}" d="M-26 36c0-17 12-25 26-25s26 8 26 25Z"/>
    <path d="M-26 36c0-17 12-25 26-25s26 8 26 25Z" fill="url(#ap-sheen)"/>
    <rect class="art-skin-shade" x="-4.5" y="0" width="9" height="13" rx="3"/>
    <ellipse class="art-skin" cx="0" cy="-7" rx="10.5" ry="12.5"/>
    {% if style in ("short", "glasses") %}
    <path class="{{ hair }}" d="M-11-7c-3-13 4-20 12-20 8 0 13 7 11 18-3-5-8-8-14-7-4 1-7 4-9 9Z"/>
    {% else %}
    <path class="{{ hair }}" d="M-11-5c-2-13 4-20 11-20 8 0 13 7 11 15-6-1-12-4-15-9-2 6-4 10-7 14Z"/>
    {% endif %}
    {% if glasses %}
    <g class="art-s-hair" fill="none" stroke-width="1.7">
      <circle cx="-4.6" cy="-6" r="3.8"/><circle cx="4.6" cy="-6" r="3.8"/><path d="M-.8-6h1.6"/>
    </g>
    {% endif %}
  </g>
</g>
{%- endmacro %}
<svg class="trouble__draw" viewBox="0 0 480 300" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="ap-clip"><rect width="480" height="300" rx="20"/></clipPath>
    <clipPath id="ap-face"><circle r="28"/></clipPath>
    <radialGradient id="ap-glow" cx="50%" cy="45%" r="65%">
      <stop offset="0" class="art-glow"/>
      <stop offset="1" class="art-glow" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="ap-sheen" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="white" stop-opacity=".45"/>
      <stop offset=".6" stop-color="white" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="ap-shade" x1="0" y1="0" x2="0" y2="1">
      <stop offset=".35" stop-color="black" stop-opacity="0"/>
      <stop offset="1" stop-color="black" stop-opacity=".2"/>
    </linearGradient>
    <filter id="ap-drop" x="-30%" y="-30%" width="160%" height="180%">
      <feDropShadow dx="0" dy="5" stdDeviation="6" class="art-drop"/>
    </filter>
  </defs>

  <g clip-path="url(#ap-clip)">
    <rect class="art-stage" width="480" height="300"/>
    <rect width="480" height="300" fill="url(#ap-glow)"/>

    {#- las líneas que las unen, con su punta, por detrás de todo -#}
    <g class="art-s-dash" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M104 44C74 58 58 82 56 104"/>
      <path d="m51 96 5 9 6-8"/>
      <path d="M62 162c6 22 22 38 40 46"/>
      <path d="M150 236c40 22 140 24 196-6"/>
      <path d="m338 226 9 3-4 9"/>
      <path d="M392 50c26 12 40 34 42 58"/>
      <path d="m428 100 6 9 6-8"/>
      <path d="M412 150c-4 22-16 38-32 46"/>
    </g>

    {#- el disco esmerilado del centro -#}
    <circle class="art-card" cx="250" cy="130" r="104" opacity=".75"/>
    <circle class="art-s-edge" cx="250" cy="130" r="104" fill="none" stroke-width="2"/>

    {#- el sobre y el candado, un poco más grandes que el resto: llenan el disco,
        como en la referencia -#}
    <g transform="translate(250 130) scale(1.12) translate(-250 -130)">
    <g transform="rotate(-5 248 124)">
      <g filter="url(#ap-drop)">
        <rect class="art-paper art-s-shade" x="174" y="74" width="148" height="100" rx="10" stroke-width="1.6"/>
      </g>
      <path class="art-s-shade" d="m178 80 70 50 70-50" fill="none" stroke-width="2.2" stroke-linejoin="round"/>
      <path class="art-s-shade" d="m180 168 44-34M316 168l-44-34" fill="none" stroke-width="1.6" opacity=".8"/>
    </g>

    {#- el candado, con su brillo y sus destellos -#}
    <path class="art-s-blue-deep" d="M237 142v-16a20 20 0 0 1 40 0v16" fill="none" stroke-width="10" stroke-linecap="round"/>
    <path d="M237 142v-16a20 20 0 0 1 40 0v16" fill="none" stroke="white" stroke-opacity=".25" stroke-width="3"
          stroke-linecap="round" transform="translate(-2 -1)"/>
    <g filter="url(#ap-drop)">
      <rect class="art-blue" x="224" y="136" width="66" height="54" rx="13"/>
    </g>
    <rect x="224" y="136" width="66" height="54" rx="13" fill="url(#ap-sheen)"/>
    <rect x="224" y="136" width="66" height="54" rx="13" fill="url(#ap-shade)"/>
    <circle class="art-blue-soft" cx="257" cy="157" r="7"/>
    <path class="art-blue-soft" d="M253.5 160h7l2 13h-11Z"/>
    <path class="art-s-blue" d="m211 146-10-3M209 162h-11M211 178l-9 4M303 126l9-6M307 142h11M305 158l9 4"
          fill="none" stroke-width="3.2" stroke-linecap="round"/>
    </g>

    {#- las seis personas, cada una en su aro -#}
    {{ person(130, 56, "art-blue") }}
    {{ person(78, 134, "art-yellow", style="bob") }}
    {{ person(124, 222, "art-navy", glasses=true) }}
    {{ person(368, 50, "art-purple", style="long") }}
    {{ person(414, 124, "art-green", hair="art-ginger") }}
    {{ person(382, 212, "art-pink", style="bob") }}
  </g>
</svg>
