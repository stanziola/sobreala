{#- Dominio personalizado (octubre de 2026, lo que era una sección aparte): los
    tres registros DNS que da Sobreala, ya verificados, y un correo que sale del
    dominio del cliente; abajo, de dónde saldría sin él. Palabras de content.py y
    colores de las clases .art-*, como los demás de Funciones. -#}
{% set w = item.words %}
<svg class="tour__art" viewBox="0 0 480 270" preserveAspectRatio="xMidYMid slice"
     role="img" aria-label="{{ item.alt }}" focusable="false">
  <defs>
    <filter id="fd-drop" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="5" stdDeviation="7" class="art-drop"/>
    </filter>
  </defs>
  <rect class="art-stage" width="480" height="270"/>

  {#- los registros, cada uno con su marca de verificado -#}
  <g filter="url(#fd-drop)">
    <rect class="art-card" x="24" y="58" width="190" height="154" rx="16"/>
  </g>
  <text class="art-ink" x="42" y="88" font-size="13.5" font-weight="700">{{ w.records }}</text>
  {% for _ in range(3) %}
  {% set top = 104 + loop.index0 * 34 %}
  <rect class="art-blue-soft" x="42" y="{{ top }}" width="58" height="22" rx="11" opacity=".55"/>
  <text class="art-blue" x="71" y="{{ top + 15 }}" text-anchor="middle" font-size="10"
        font-weight="700">{{ w.kind }}</text>
  <rect class="art-line" x="110" y="{{ top + 7 }}" width="{{ (62, 48, 56)[loop.index0] }}" height="8" rx="4"/>
  <circle class="art-green" cx="190" cy="{{ top + 11 }}" r="9"/>
  <path d="m185.5 {{ top + 11 }} 3 3 6-6.5" fill="none" stroke="white" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round"/>
  {% endfor %}

  {#- el correo que sale del dominio -#}
  <g filter="url(#fd-drop)">
    <rect class="art-card" x="236" y="44" width="222" height="182" rx="16"/>
  </g>
  <text class="art-ink" x="254" y="76" font-size="11" opacity=".62">{{ w.from }}</text>
  <text class="art-ink" x="276" y="76" font-size="12.5" font-weight="700">{{ w.own }}</text>
  <rect class="art-green" x="254" y="88" width="88" height="22" rx="11"/>
  <path d="m264 99 3 3 6-6.5" fill="none" stroke="white" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round"/>
  <text x="306" y="103" text-anchor="middle" font-size="10.5" font-weight="700"
        fill="white">{{ w.ok }}</text>
  <rect class="art-line" x="254" y="124" width="182" height="8" rx="4"/>
  <rect class="art-line" x="254" y="142" width="150" height="8" rx="4"/>
  <rect class="art-line" x="254" y="160" width="166" height="8" rx="4"/>
  <rect class="art-card-edge" x="254" y="182" width="186" height="1.5"/>
  <text class="art-ink" x="254" y="200" font-size="10" opacity=".62">{{ w.shared_label }}</text>
  <text class="art-ink" x="254" y="215" font-size="10" font-weight="600" opacity=".62">{{ w.shared }}</text>
</svg>
