{#- Rebotes y quejas fuera: un sobre con su aviso de rebote, y la lista de lo
    que ya no recibe, con las direcciones tachadas y por qué. Palabras de
    content.py y colores de las clases .art-*, como los demás dibujos de
    Features. -#}
{% set w = item.words %}
<svg class="tour__art" viewBox="0 0 480 270" preserveAspectRatio="xMidYMid slice"
     role="img" aria-label="{{ item.alt }}" focusable="false">
  <defs>
    <filter id="fb-drop" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" class="art-drop"/>
    </filter>
  </defs>
  <rect class="art-stage" width="480" height="270"/>

  <g transform="translate(14 0)">
  {#- el sobre, con su solapa y el aviso -#}
  <g filter="url(#fb-drop)">
    <rect class="art-card" x="34" y="98" width="110" height="74" rx="10"/>
  </g>
  <path class="art-s-line" d="M40 104l49 36 49-36" fill="none" stroke-width="2.4"
        stroke-linecap="round" stroke-linejoin="round"/>
  <circle class="art-red" cx="140" cy="100" r="14"/>
  <path d="M140 92.5v9" stroke="white" stroke-width="2.8" stroke-linecap="round"/>
  <circle cx="140" cy="107" r="1.7" fill="white"/>


  </g>

  <g transform="translate(-20 0)">
  {#- lo que ya no recibe: la dirección tachada y su motivo -#}
  <g filter="url(#fb-drop)">
    <rect class="art-card" x="204" y="66" width="252" height="138" rx="16"/>
  </g>
  <text class="art-ink" x="224" y="98" font-size="14" font-weight="700">{{ w.title }}</text>
  {% for email, label, color, strike in w.rows %}
  {% set top = 114 + loop.index0 * 42 %}
  <rect class="art-card-edge" x="224" y="{{ top }}" width="212" height="1.5"/>
  <text class="art-ink" x="224" y="{{ top + 27 }}" font-size="12.5" font-weight="600" opacity=".62">{{ email }}</text>
  <rect class="art-ink" x="223" y="{{ top + 22 }}" width="{{ strike }}" height="1.6" opacity=".7"/>
  <rect class="{{ color }}" x="370" y="{{ top + 11 }}" width="66" height="22" rx="11"/>
  <text x="403" y="{{ top + 26 }}" text-anchor="middle" font-size="10.5" font-weight="700" fill="white">{{ label }}</text>
  {% endfor %}
  </g>
</svg>
