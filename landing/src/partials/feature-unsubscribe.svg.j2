{#- Bajas, rebotes y quejas (octubre de 2026, lo que eran dos dibujos): el pie
    de un correo con su enlace para anular la suscripción, y al lado la lista de
    lo que ya no recibe, con las direcciones tachadas y por qué. Palabras de
    content.py y colores de las clases .art-*, como los demás de Funciones. -#}
{% set w = item.words %}
<svg class="tour__art" viewBox="0 0 480 270" preserveAspectRatio="xMidYMid slice"
     role="img" aria-label="{{ item.alt }}" focusable="false">
  <defs>
    <filter id="fu-drop" x="-30%" y="-20%" width="160%" height="150%">
      <feDropShadow dx="0" dy="5" stdDeviation="7" class="art-drop"/>
    </filter>
  </defs>
  <rect class="art-stage" width="480" height="270"/>

  {#- el correo: unas rayas que hacen de texto, la raya del pie y el enlace -#}
  <g filter="url(#fu-drop)">
    <rect class="art-card" x="26" y="38" width="186" height="194" rx="14"/>
  </g>
  <rect class="art-line" x="46" y="60" width="146" height="8" rx="4"/>
  <rect class="art-line" x="46" y="78" width="116" height="8" rx="4"/>
  <rect class="art-line" x="46" y="96" width="132" height="8" rx="4"/>
  <rect class="art-line" x="46" y="114" width="92" height="8" rx="4"/>
  <rect class="art-card-edge" x="46" y="146" width="146" height="1.5"/>
  <text class="art-ink" x="119" y="168" text-anchor="middle" font-size="10.5"
        opacity=".62">{{ w.sender }}</text>
  <rect class="art-blue-soft" x="49" y="180" width="140" height="26" rx="13" opacity=".45"/>
  <text class="art-blue" x="119" y="197.5" text-anchor="middle" font-size="12.5"
        font-weight="700">{{ w.link }}</text>


  {#- el mouse, sobre el enlace: es lo que se pulsa -#}
  <g transform="translate(172 196)">
    <path d="M0 0v20l5.2-4.6 3.6 8.2 3.6-1.6-3.6-8h7.2z" class="art-ink art-s-paper"
          stroke-width="1.6" stroke-linejoin="round"/>
  </g>

  {#- lo que ya no recibe: la dirección tachada y su motivo -#}
  <g filter="url(#fu-drop)">
    <rect class="art-card" x="236" y="50" width="222" height="170" rx="16"/>
  </g>
  <text class="art-ink" x="254" y="80" font-size="14" font-weight="700">{{ w.title }}</text>
  {% for email, label, color, strike in w.rows %}
  {% set top = 94 + loop.index0 * 40 %}
  <rect class="art-card-edge" x="254" y="{{ top }}" width="186" height="1.5"/>
  <text class="art-ink" x="254" y="{{ top + 26 }}" font-size="12" font-weight="600" opacity=".62">{{ email }}</text>
  <rect class="art-ink" x="253" y="{{ top + 21.5 }}" width="{{ strike * 0.96 }}" height="1.6" opacity=".7"/>
  <rect class="{{ color }}" x="380" y="{{ top + 10 }}" width="60" height="22" rx="11"/>
  <text x="410" y="{{ top + 25 }}" text-anchor="middle" font-size="10.5" font-weight="700" fill="white">{{ label }}</text>
  {% endfor %}
</svg>
