{#- Hacerlo a mano cuesta horas: alguien frente al portátil, la pila de sobres
    que le falta, la lista de la pared y el reloj corriendo. Sin una palabra
    dentro: los colores salen de las clases .art-*, que el CSS ata a las
    variables de la marca, así que se da la vuelta sola con el tema. -#}
<svg class="trouble__draw" viewBox="0 0 400 250" aria-hidden="true" focusable="false">
  {#- la lista de la pared -#}
  <rect class="art-card art-line" x="116" y="12" width="176" height="108" rx="10" stroke-width="2"/>
  {% for top in [26, 48, 70, 92] %}
  <rect class="art-card art-line-key" x="130" y="{{ top }}" width="20" height="15" rx="3" stroke-width="2"/>
  <path class="art-line-key" d="m131 {{ top + 1.5 }} 9 6.5 9-6.5" fill="none" stroke-width="2"/>
  <rect class="art-mute" x="160" y="{{ top + 1 }}" width="{{ 96 if loop.index is odd else 78 }}" height="5" rx="2.5"/>
  <rect class="art-mute" x="160" y="{{ top + 10 }}" width="{{ 62 if loop.index is odd else 50 }}" height="5" rx="2.5"/>
  {% endfor %}

  {#- el reloj, con sus rayas de prisa -#}
  <circle class="art-card" cx="330" cy="64" r="31"/>
  <circle class="art-line-quiet" cx="330" cy="64" r="34" fill="none" stroke-width="7"/>
  <path class="art-edge" d="M330 44v20l15 9" fill="none" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
  <circle class="art-key" cx="330" cy="64" r="3.5"/>
  <path class="art-line-key" d="m374 24 8-8M383 44h11M362 14l4-10" fill="none" stroke-width="3" stroke-linecap="round"/>

  {#- el escritorio: todo lo de abajo se apoya en esta línea -#}
  <line class="art-edge" x1="10" y1="226" x2="390" y2="226" stroke-width="2.5" stroke-linecap="round"/>

  {#- la pila de sobres que falta por mandar -#}
  {% for top in [212, 199, 186, 173, 160] %}
  <rect class="art-card art-line" x="{{ 20 + loop.index0 }}" y="{{ top }}" width="76" height="14" rx="4" stroke-width="2"/>
  {% endfor %}
  <path class="art-line" d="m28 163 33 11 33-11" fill="none" stroke-width="2"/>

  {#- la taza -#}
  <rect class="art-card art-line" x="104" y="203" width="23" height="23" rx="5" stroke-width="2"/>
  <path class="art-line" d="M127 209h5a6 6 0 0 1 0 12h-5" fill="none" stroke-width="2"/>

  {#- la maceta -#}
  <path class="art-quiet" d="M306 226l-4-22h34l-4 22Z"/>
  <path class="art-key" d="M320 204c-2-16 4-26 17-30 2 16-6 27-17 30Z"/>
  <path class="art-key" d="M320 204c-9-9-10-18-4-27-11 7-12 18 4 27Z"/>

  {#- la persona: cabeza, pelo, cuello y hombros, y el portátil delante. Los
      hombros salen más anchos que la tapa a propósito, que si no la persona
      desaparece detrás de ella. -#}
  <circle class="art-key" cx="196" cy="147" r="21"/>
  <path class="art-quiet" d="M175 147a21 21 0 0 1 42 0c-5-11-13-16-21-16s-16 5-21 16Z"/>
  <rect class="art-key" x="187" y="163" width="18" height="22"/>
  <path class="art-key" d="M130 226v-10c0-27 30-42 66-42s66 15 66 42v10Z"/>
  <path class="art-card art-line" d="M154 213v-29a5 5 0 0 1 5-5h74a5 5 0 0 1 5 5v29Z" stroke-width="2"/>
  <rect class="art-card art-line" x="142" y="213" width="108" height="13" rx="6.5" stroke-width="2"/>
</svg>
