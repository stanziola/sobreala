{#- Hacerlo a mano cuesta horas: el chico tecleando en su portátil, con la pila
    de sobres que le falta, la lista de la pared y el reloj corriendo. Sigue el
    encuadre de la imagen de referencia. Los colores salen de las clases .art-*,
    atadas a la paleta de brand/colors.css, así que de noche es otra escena sin
    tocar este archivo; el volumen son dos degradados de luz y de sombra, en
    blanco y negro con transparencia. Sin una palabra dentro. -#}
<svg class="trouble__draw" viewBox="0 0 480 300" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="am-clip"><rect width="480" height="300" rx="20"/></clipPath>
    <radialGradient id="am-glow" cx="50%" cy="30%" r="70%">
      <stop offset="0" class="art-glow"/>
      <stop offset="1" class="art-glow" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="am-sheen" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="white" stop-opacity=".5"/>
      <stop offset=".6" stop-color="white" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="am-shade" x1="0" y1="0" x2="0" y2="1">
      <stop offset=".4" stop-color="black" stop-opacity="0"/>
      <stop offset="1" stop-color="black" stop-opacity=".18"/>
    </linearGradient>
    <filter id="am-drop" x="-30%" y="-30%" width="160%" height="170%">
      <feDropShadow dx="0" dy="5" stdDeviation="6" class="art-drop"/>
    </filter>
    <path id="am-sweater" d="M160 262c-3-50 8-92 44-104 16-5 34-7 54-7 19 0 35 3 47 9 24 12 28 52 26 102Z"/>
    <path id="am-lid" d="M286 172a5 5 0 0 1 5-5l80-4a4 4 0 0 1 4 5l-15 72a5 5 0 0 1-5 4l-79 4a4 4 0 0 1-4-5Z"/>
    <path id="am-mug" d="M130 226h38v32a8 8 0 0 1-8 8h-22a8 8 0 0 1-8-8Z"/>
  </defs>

  <g clip-path="url(#am-clip)">
    {#- la pared, su resplandor y la mesa -#}
    <rect class="art-stage" width="480" height="300"/>
    <rect width="480" height="300" fill="url(#am-glow)"/>
    <rect class="art-floor" y="232" width="480" height="68"/>

    {#- la lista de la pared, un poco torcida -#}
    <g transform="translate(18 0) rotate(-3 134 90)" filter="url(#am-drop)">
      <rect class="art-card" x="56" y="28" width="160" height="122" rx="11"/>
    </g>
    <g transform="translate(18 0) rotate(-3 134 90)">
      {% for top in [46, 72, 98, 124] %}
      <rect class="art-blue" x="74" y="{{ top }}" width="22" height="16" rx="3.5"/>
      <path class="art-s-paper" d="m76 {{ top + 3 }} 9 6.5 9-6.5" fill="none" stroke-width="1.7"
            stroke-linecap="round" stroke-linejoin="round"/>
      <rect class="art-line" x="106" y="{{ top + 1 }}" width="{{ [88, 76, 90, 70][loop.index0] }}" height="6" rx="3"/>
      <rect class="art-line" x="106" y="{{ top + 10 }}" width="{{ [60, 50, 64, 46][loop.index0] }}" height="5" rx="2.5"/>
      {% endfor %}
    </g>

    {#- el reloj, con sus doce marcas y sus rayas de prisa -#}
    <g filter="url(#am-drop)">
      <circle class="art-blue" cx="394" cy="100" r="52"/>
    </g>
    <circle cx="394" cy="100" r="52" fill="url(#am-sheen)"/>
    <circle cx="394" cy="100" r="52" fill="url(#am-shade)"/>
    <circle class="art-paper" cx="394" cy="100" r="41"/>
    {% for i in range(12) %}
    <line class="art-s-blue-soft" x1="394" y1="{{ 63 if i % 3 == 0 else 65 }}" x2="394" y2="69"
          stroke-width="{{ 3 if i % 3 == 0 else 2 }}" stroke-linecap="round"
          transform="rotate({{ i * 30 }} 394 100)"/>
    {% endfor %}
    <path class="art-s-navy" d="M394 100 413 81M394 100 392 76" fill="none" stroke-width="4"
          stroke-linecap="round"/>
    <circle class="art-navy" cx="394" cy="100" r="4.5"/>
    <path class="art-s-blue" d="m431 40 7-9M443 55l11-3M418 33l2-11" fill="none" stroke-width="3.5"
          stroke-linecap="round"/>

    {#- la planta -#}
    <path class="art-leaf" d="M434 212c-9-14-14-30-17-50 11 11 17 28 17 50Z"/>
    <path class="art-leaf-deep" d="M434 212c-2-24 3-44 14-60 3 20-3 42-14 60Z"/>
    <path class="art-leaf" d="M434 212c7-15 20-28 36-34-5 16-19 29-36 34Z"/>
    <path class="art-leaf-deep" d="M434 212c-13-8-28-10-40-8 10 9 25 12 40 8Z"/>
    <path class="art-leaf" d="M434 212c10-6 24-7 34-2-9 6-22 8-34 2Z"/>
    <g filter="url(#am-drop)">
      <path class="art-paper" d="M414 210h40l-5 36a5 5 0 0 1-5 4h-20a5 5 0 0 1-5-4Z"/>
    </g>
    <path d="M414 210h40l-5 36a5 5 0 0 1-5 4h-20a5 5 0 0 1-5-4Z" fill="url(#am-shade)"/>

    {#- la pila de sobres que le falta mandar, un poco desordenada -#}
    <g filter="url(#am-drop)">
      {% for top, left, turn in [(240, 20, -1), (227, 25, 2), (214, 19, -2), (201, 24, 1),
                                 (188, 21, -1.5), (175, 26, 2.5), (162, 20, -1), (149, 25, 1.5)] %}
      <g transform="rotate({{ turn }} {{ left + 48 }} {{ top + 7 }})">
        <rect class="art-paper art-s-shade" x="{{ left }}" y="{{ top }}" width="96" height="14" rx="3"
              stroke-width="1.4"/>
        <path class="art-s-shade" d="m{{ left + 3 }} {{ top + 2 }} 45 8.5 45-8.5" fill="none"
              stroke-width="1.3" stroke-linejoin="round"/>
      </g>
      {% endfor %}
    </g>

    {#- él: el cuello, el jersey, la cara y el pelo -#}
    <path class="art-skin-shade" d="M256 146h20v18c-5 4-15 4-20 0Z"/>
    <use href="#am-sweater" class="art-sweater"/>
    <use href="#am-sweater" fill="url(#am-sheen)" opacity=".45"/>
    <path class="art-sweater" d="M238 158c9-6 20-8 27-8s17 2 26 8c-8 7-17 9-26 9s-18-2-27-9Z"/>
    <path class="art-s-hair" d="M240 159c8 5 16 8 25 8s17-3 25-8" fill="none" stroke-width="2" opacity=".35"/>
    {#- la cabeza baja e inclinada hacia la pantalla, con la barbilla casi en el
        cuello, como en la referencia -#}
    <g transform="translate(4 13) rotate(-5 266 112)">
      <ellipse class="art-skin-shade" cx="241" cy="113" rx="6.5" ry="9.5"/>
      <path class="art-skin" d="M243 107c0-17 12-28 26-28 16 0 26 12 25 29-1 18-11 33-25 34-14 1-26-12-26-35Z"/>
      <path class="art-hair" d="M237 114c-5-22 5-43 26-49 13-3 29 0 37 10 7 9 7 21 1 30-4-8-12-11-19-9-6-5-14-6-20-2-6-3-13 0-15 7-4 3-7 8-10 13Z"/>
      <path class="art-hair" d="M252 72c3-9 12-14 22-12-6 3-10 7-11 12ZM279 64c9-2 17 3 20 10-6-4-13-5-19-3ZM240 88c-2-8 1-15 7-19-2 6-2 12 0 17Z"/>
      <path class="art-s-hair" d="M256 107l10-2M277 105l10 3" fill="none" stroke-width="2.6" stroke-linecap="round"/>
      <ellipse class="art-hair" cx="263" cy="117" rx="2.6" ry="3.2"/>
      <ellipse class="art-hair" cx="283" cy="118" rx="2.6" ry="3.2"/>
      <path class="art-skin-shade" d="M274 118c3 5 4 9 1 12h-4c2-3 3-7 3-12Z"/>
      <path class="art-s-hair" d="M265 133c4 1 8 1 11-1" fill="none" stroke-width="1.8" stroke-linecap="round" opacity=".55"/>
    </g>

    {#- las rayas de prisa, entre él y el reloj -#}
    <path class="art-s-blue" d="m308 86 8-7M310 101h11M308 116l8 6" fill="none" stroke-width="3.2"
          stroke-linecap="round"/>

    {#- los brazos y las manos, hacia el teclado -#}
    <path class="art-sweater" d="M170 190c-10 28 2 52 38 58l10-14c-18-5-26-18-25-36Z"/>
    <path class="art-sweater" d="M322 200c4 22-4 38-30 44l-8-12c14-4 20-14 18-26Z"/>
    <path class="art-skin" d="M222 240c4-8 14-10 22-6 4 2 4 7 0 9l-14 5c-5 1-9-3-8-8Z"/>
    <path class="art-skin" d="M262 238c4-8 14-9 21-5 4 2 4 7 0 9l-13 5c-5 1-9-3-8-9Z"/>

    {#- el portátil: la tapa mirando hacia aquí, con su logo, y el teclado -#}
    <path class="art-silver" d="M204 246l170-8 6 8-170 9Z"/>
    <path d="M204 246l170-8 6 8-170 9Z" fill="url(#am-shade)"/>
    <g filter="url(#am-drop)">
      <use href="#am-lid" class="art-silver"/>
    </g>
    <use href="#am-lid" fill="url(#am-sheen)"/>
    <circle cx="327" cy="206" r="8" fill="white" fill-opacity=".45"/>

    {#- la taza, la libreta y el boli -#}
    <path class="art-s-blue" d="M130 234c-12 0-12 20 0 20" fill="none" stroke-width="5"/>
    <g filter="url(#am-drop)">
      <use href="#am-mug" class="art-blue"/>
    </g>
    <use href="#am-mug" fill="url(#am-sheen)"/>
    <ellipse class="art-blue-deep" cx="149" cy="226" rx="19" ry="4.5"/>
    <g transform="rotate(-5 206 270)">
      <g filter="url(#am-drop)">
        <rect class="art-paper art-s-shade" x="172" y="262" width="70" height="18" rx="3" stroke-width="1.2"/>
      </g>
      <path class="art-s-navy" d="m184 266 38-3" fill="none" stroke-width="4" stroke-linecap="round"/>
      <path class="art-navy" d="m222 261 7 1-7 3Z"/>
    </g>
  </g>
</svg>
