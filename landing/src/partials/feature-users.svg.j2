{#- Usuarios de la cuenta: quien la tiene y una persona invitada, y lo que esa
    persona puede hacer, con sus casillas. Palabras de content.py y colores de
    las clases .art-*, como los demás dibujos de Features. El prefijo de los
    id es fus-, porque fu- ya es el de la baja. -#}
{% set w = item.words %}
<svg class="tour__art" viewBox="0 0 480 270" preserveAspectRatio="xMidYMid slice"
     role="img" aria-label="{{ item.alt }}" focusable="false">
  <defs>
    <filter id="fus-drop" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" class="art-drop"/>
    </filter>
  </defs>
  <rect class="art-stage" width="480" height="270"/>

  {#- las personas de la cuenta, cada una con su papel -#}
  <g filter="url(#fus-drop)">
    <rect class="art-card" x="24" y="62" width="206" height="146" rx="16"/>
  </g>
  <text class="art-ink" x="44" y="94" font-size="14" font-weight="700">{{ w.title }}</text>
  {% for name, role, face, pill in [(w.owner, w.owner_role, "art-blue", "art-blue"),
                                     (w.guest, w.guest_role, "art-purple", "art-purple")] %}
  {% set top = 108 + loop.index0 * 46 %}
  <rect class="art-card-edge" x="44" y="{{ top }}" width="166" height="1.5"/>
  <circle class="{{ face }}" cx="58" cy="{{ top + 23 }}" r="12"/>
  <circle class="art-card" cx="58" cy="{{ top + 19.5 }}" r="4"/>
  <path class="art-card" d="M51 {{ top + 31 }}a7 5.5 0 0 1 14 0z"/>
  <text class="art-ink" x="80" y="{{ top + 28 }}" font-size="13" font-weight="700">{{ name }}</text>
  <rect class="{{ pill }}" x="134" y="{{ top + 12 }}" width="74" height="22" rx="11"/>
  <text x="171" y="{{ top + 27 }}" text-anchor="middle" font-size="10.5" font-weight="700" fill="white">{{ role }}</text>
  {% endfor %}


  {#- sus permisos: marcados los que tiene -#}
  <g filter="url(#fus-drop)">
    <rect class="art-card" x="256" y="54" width="200" height="162" rx="16"/>
  </g>
  <text class="art-ink" x="276" y="84" font-size="13.5" font-weight="700">{{ w.can }}</text>
  {% for label, on in w.permissions %}
  {% set top = 100 + loop.index0 * 27 %}
  {% if on %}
  <rect class="art-blue" x="276" y="{{ top }}" width="17" height="17" rx="4.5"/>
  <path d="m280 {{ top + 8.5 }} 3.4 3.4 6-6.6" fill="none" stroke="white" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round"/>
  {% else %}
  <rect class="art-s-edge" x="277" y="{{ top + 1 }}" width="15" height="15" rx="4" fill="none" stroke-width="2"/>
  {% endif %}
  <text class="art-ink" x="302" y="{{ top + 13 }}" font-size="12.5" font-weight="600"{% if not on %} opacity=".55"{% endif %}>{{ label }}</text>
  {% endfor %}
</svg>
