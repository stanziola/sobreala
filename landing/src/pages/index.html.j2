{% extends "base.html.j2" %}
{% from "partials/feature-icons.html.j2" import feature_icon %}

{% block main %}

<section class="hero">
  <div class="shell hero__inner">
    <div class="hero__text">
      <h1 class="hero__title">
        {{ page.hero.title_lead }}
        <span class="hero__title-accent">{{ page.hero.title_accent }}</span>
      </h1>
      <p class="hero__subtitle">{{ page.hero.subtitle }}</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="{{ whatsapp_url }}" target="_blank" rel="noopener">
          {{ cta_primary.label }}
        </a>
        <a class="btn btn--outline btn--lg" href="{{ cta_secondary.url }}">{{ cta_secondary.label }}</a>
      </div>
      <p class="hero__note">{{ page.hero.note }}</p>
    </div>
    <div class="hero__art">
      <div class="hero__wing">{{ wing_svg }}</div>
    </div>
  </div>
</section>

<section class="section section--alt" aria-labelledby="problema-title">
  <div class="shell">
    <div class="section__head">
      <h2 class="section__title" id="problema-title">{{ page.problem.title }}</h2>
    </div>
    {#- Los cuatro puntos, con el que estás viendo marcado. Lo que abre cada uno
        son botones de radio, como el carrusel de capturas: así funciona entero
        sin JavaScript y las flechas del teclado lo mueven solas. trouble.js
        solo agrega el paso automático. -#}
    <div class="trouble" data-trouble>
      {% for item in page.problem['items'] %}
      <input class="trouble__pick" type="radio" name="trouble"
             id="pain-{{ loop.index }}"{{ " checked" if loop.first }}>
      {% endfor %}
      <ol class="trouble__list">
        {% for item in page.problem['items'] %}
        <li>
          <label class="trouble__step" for="pain-{{ loop.index }}">
            <span class="trouble__mark" aria-hidden="true">
              <span class="trouble__n">{{ loop.index }}</span>
              {%- include "partials/icon-check.svg.j2" -%}
            </span>
            <span class="trouble__said">
              <span class="trouble__title">{{ item.title }}</span>
              <span class="trouble__lead">{{ item.lead }}</span>
            </span>
          </label>
        </li>
        {% endfor %}
      </ol>
      {#- Las cuatro ilustraciones comparten una celda y los cuatro párrafos
          otra, así que el bloque mide siempre lo que el más largo y no salta al
          cambiar de punto. -#}
      <div class="trouble__art">
        <div class="trouble__frame">
          {% for item in page.problem['items'] %}
          <div class="trouble__shot trouble__one">{% include "partials/art-" ~ item.art ~ ".svg.j2" %}</div>
          {% endfor %}
        </div>
        <div class="trouble__notes">
          {% for item in page.problem['items'] %}
          <p class="trouble__note trouble__one">{{ item.text }}</p>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{#- Sigue al tema como el resto de la página: hubo una banda que se invertía,
    y existía solo porque las capturas del panel eran siempre oscuras. Ahora hay
    un juego por tema, así que no hace falta. -#}
<section class="section" aria-labelledby="features-title">
  <div class="shell">
    <div class="section__head">
      <h2 class="section__title" id="features-title">{{ page.features.title }}</h2>
      <p class="section__intro">{{ page.features.intro }}</p>
    </div>
    {#- Capturas del panel de verdad, hechas con landing/shots.py. Los botones
        de radio son los que abren cada una, asi que esto funciona entero sin
        JavaScript y con el teclado; carousel.js solo agrega las flechas y el
        paso automatico. -#}
    <div class="tour" data-tour
         data-tour-zoom="{{ page.features.zoom }}"
         data-tour-close="{{ page.features.close }}">
      {% for item in page.features['items'] %}
      <input class="tour__pick" type="radio" name="tour"
             id="tour-{{ loop.index }}"{{ " checked" if loop.first }}>
      {% endfor %}
      <div class="tour__strip">
        {% for item in page.features['items'] %}
        <label class="tour__panel" for="tour-{{ loop.index }}">
          {#- Dos juegos de capturas, uno por tema. La que no toca va en
              `display: none`, y como las diez van `lazy` el navegador no se baja
              la que no se ve: una sola de las dos cuesta bytes. -#}
          <img class="tour__shot tour__shot--light"
               src="/assets/img/panel/light/{{ item.shot }}.webp"
               alt="{{ item.alt }}" width="1400" height="788"
               decoding="async" loading="lazy">
          <img class="tour__shot tour__shot--dark"
               src="/assets/img/panel/dark/{{ item.shot }}.webp"
               alt="{{ item.alt }}" width="1400" height="788"
               decoding="async" loading="lazy">
        </label>
        {% endfor %}
      </div>
      <div class="tour__texts">
        {% for item in page.features['items'] %}
        <div class="tour__text">
          <h3 class="tour__title">{{ item.title }}</h3>
          <p>{{ item.text }}</p>
        </div>
        {% endfor %}
      </div>
      <p class="tour__nav">
        <button class="tour__arrow" type="button" data-tour-back
                aria-label="{{ page.features.back }}">
          {%- include "partials/icon-caret.svg.j2" -%}</button>
        <button class="tour__arrow" type="button" data-tour-next
                aria-label="{{ page.features.next }}">
          {%- include "partials/icon-caret.svg.j2" -%}</button>
      </p>
    </div>
  </div>
</section>

<section class="section section--alt" aria-labelledby="pasos-title">
  <div class="shell">
    <div class="section__head">
      <p class="eyebrow">{{ page.steps.eyebrow }}</p>
      <h2 class="section__title" id="pasos-title">{{ page.steps.title }}</h2>
      <p class="section__intro">{{ page.steps.intro }}</p>
    </div>
  </div>
  {#- La tira corre de lado a lado, fuera del shell. Va tres veces seguidas para
      que el bucle no se note: con cuatro plantillas una lista mide menos que
      una pantalla ancha, y con dos se vería su final. Las copias van escondidas
      del lector de pantalla y del tabulador, así cada plantilla se recorre una
      sola vez. Solo CSS. -#}
  <div class="samples">
    <div class="samples__track">
      {% for copy in (0, 1, 2) %}
      <ul class="samples__list"{% if copy %} aria-hidden="true"{% endif %}>
        {% for one in samples %}
        <li>
          <a class="sample" href="{{ panel.base_url }}/templates/sample/{{ one.slug }}"
             aria-label="{{ page.steps.open | replace('{name}', one.name) }}"
             {%- if copy %} tabindex="-1"{% endif %}>
            <img class="sample__picture" src="{{ one.image }}" alt=""
                 width="{{ one.size[0] }}" height="{{ one.size[1] }}" loading="lazy">
            <span class="sample__name">{{ one.name }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
      {% endfor %}
    </div>
  </div>
  <div class="shell">
    <p class="section__actions">
      <a class="btn btn--primary btn--lg" href="{{ page.steps.cta.url }}">{{ page.steps.cta.label }}</a>
    </p>
  </div>
</section>

{% with faq = page.faq %}{% include "partials/faq.html.j2" %}{% endwith %}

{% endblock %}

{% block scripts %}
<script src="/assets/js/trouble.js" defer></script>
<script src="/assets/js/carousel.js" defer></script>
{% endblock %}
