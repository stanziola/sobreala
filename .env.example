# development o production. En production se apaga el modo de depuracion,
# SECRET_KEY deja de tener valor por defecto y la sesion exige HTTPS.
FLASK_ENV=development

# Cluster de MongoDB Atlas: mongodb+srv://usuario:clave@host/...
# La dirección del servidor debe estar en la lista de acceso de Atlas.
MONGODB_URI=
MONGODB_DB=panamails_app
SECRET_KEY=

# Base para los enlaces de los correos. En producción, el dominio del panel.
APP_BASE_URL=http://127.0.0.1:5000
# El sitio público, que es otro despliegue. De ahí cuelgan los términos y la
# política de privacidad, y ahí lleva el logo del panel cuando no hay sesión.
# En local, el puerto donde sirvas landing/ (python landing/build_site.py --serve).
PUBLIC_SITE_URL=https://panamails.com
# Minutos que vale el código de confirmación de 6 dígitos.
CONFIRMATION_CODE_MINUTES=30
CONFIRMATION_TOKEN_HOURS=24

# Cómo se envían los correos del sistema:
#   file  se guardan en disco y el enlace se imprime (desarrollo)
#   smtp  servidor SMTP corriente, puente mientras SES está en pruebas
#   ses   Amazon SES por su API (producción)
MAIL_BACKEND=file
# Tiene que ser una direccion de la identidad verificada en SES (panamails.com,
# que cubre sus subdominios). No uses mail.panamails.com: ese subdominio es el
# MAIL FROM y su MX apunta a SES, asi que las respuestas se perderian.
SYSTEM_FROM_EMAIL=cuenta@panamails.com
SYSTEM_FROM_NAME=Panamails
SES_TRANSACTIONAL_CONFIGURATION_SET=

# Solo con MAIL_BACKEND=smtp. Con Gmail hace falta una contraseña de aplicación,
# no la del correo. MAIL_SMTP_FROM debe ser el mismo buzón que autentica: enviar
# como otro dominio por el SMTP ajeno falla SPF y DKIM y cae en spam.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_FROM=

# Con MAIL_BACKEND=ses hacen falta estas tres. Las lee boto3 del entorno; la
# aplicacion se niega a arrancar si falta alguna. La identidad verificada en SES
# tiene que ser la de SYSTEM_FROM_EMAIL, arriba.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# La region donde esta verificada la identidad de SES, no la de Atlas.
AWS_REGION=us-east-2
# De las campanas de los clientes, todavia sin usar.
SES_CONFIGURATION_SET=
SENDING_DOMAIN=envios.panamails.com

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

YAPPY_MERCHANT_ID=
YAPPY_SECRET=
