# development o production. En production se apaga el modo de depuracion,
# SECRET_KEY deja de tener valor por defecto y la sesion exige HTTPS.
FLASK_ENV=development

# Cluster de MongoDB Atlas: mongodb+srv://usuario:clave@host/...
# La dirección del servidor debe estar en la lista de acceso de Atlas.
MONGODB_URI=
MONGODB_DB=panamails_app
SECRET_KEY=

# Base para los enlaces de los correos. En producción, el dominio del panel.
APP_BASE_URL=http://127.0.0.1:5000
# El sitio público, que es otro despliegue. De ahí cuelgan los términos y la
# política de privacidad, y ahí lleva el logo del panel cuando no hay sesión.
# En local, el puerto donde sirvas landing/ (python landing/build_site.py --serve).
PUBLIC_SITE_URL=https://panamails.com
# Minutos que vale el código de confirmación de 6 dígitos. Es el único
# vencimiento que lee la aplicación.
CONFIRMATION_CODE_MINUTES=30
# Horas que sobrevive un registro que nunca se confirma. Pasadas, Mongo borra la
# cuenta y la dirección queda libre otra vez.
UNCONFIRMED_HOURS=24

# Cómo se envían los correos del sistema:
#   file  se guardan en disco y el enlace se imprime (desarrollo)
#   smtp  servidor SMTP corriente, puente mientras SES está en pruebas
#   ses   Amazon SES por su API (producción)
MAIL_BACKEND=file
# Tiene que ser una direccion de la identidad verificada en SES (panamails.com,
# que cubre sus subdominios). No uses mail.panamails.com: ese subdominio es el
# MAIL FROM y su MX apunta a SES, asi que las respuestas se perderian.
SYSTEM_FROM_EMAIL=cuenta@panamails.com
SYSTEM_FROM_NAME=Panamails
SES_TRANSACTIONAL_CONFIGURATION_SET=

# Solo con MAIL_BACKEND=smtp. Con Gmail hace falta una contraseña de aplicación,
# no la del correo. MAIL_SMTP_FROM debe ser el mismo buzón que autentica: enviar
# como otro dominio por el SMTP ajeno falla SPF y DKIM y cae en spam.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_FROM=

# Con MAIL_BACKEND=ses hacen falta estas tres. Las lee boto3 del entorno; la
# aplicacion se niega a arrancar si falta alguna. La identidad verificada en SES
# tiene que ser la de SYSTEM_FROM_EMAIL, arriba.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# La region donde esta verificada la identidad de SES, no la de Atlas.
AWS_REGION=us-east-2
# Los conjuntos de configuracion de SES: uno para las campanas (con aperturas
# y clics) y otro para el correo del sistema, arriba (sin ellos). Son lo que
# hace que SES avise de cada entrega, rebote y queja. Ver docs/ses.md.
SES_CONFIGURATION_SET=
# Lo que autoriza los avisos, porque viaja en la direccion del webhook:
# https://panel.panamails.com/webhooks/ses/<secreto>. Largo y al azar; sin el
# puesto, esa direccion responde 404.
SES_WEBHOOK_SECRET=
# El tema de SNS del que se aceptan avisos. Vacio acepta cualquiera.
SES_TOPIC_ARN=
SENDING_DOMAIN=envios.panamails.com

# Las imagenes que el cliente pone en sus plantillas no necesitan ninguna
# variable: se achican y se guardan en la misma base, y el correo las pide a
# APP_BASE_URL/img/<nombre>. No hay proveedor aparte ni tarjeta que dejar.

# La direccion postal del pie de las campanas ya no es una variable: es la de
# cada cliente, y la escribe en Configuracion -> Cuenta.

# Pagos con PayPal. Las llaves salen de developer.paypal.com, en Apps &
# Credentials. Arriba hay dos pestanas, Sandbox y Live, y cada una tiene su
# propia aplicacion con su propio par: la de sandbox mueve dinero falso y la de
# live cobra tarjetas de verdad. No son intercambiables.
#
# PAYPAL_ENV decide a que servidor de PayPal se le habla. Sin ella habria que
# cambiar la direccion a mano, que es como se cobra una tarjeta real durante una
# prueba: en produccion con sandbox la aplicacion se niega a arrancar.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Se llena cuando exista el endpoint de avisos. Se crea el webhook en el panel
# de PayPal apuntando a /webhooks/paypal y el identificador que devuelve es lo
# que permite comprobar que un aviso viene de PayPal y no de quien encontro la
# direccion. Vacio hasta entonces.
PAYPAL_WEBHOOK_ID=

# Tarjetas Visa y Mastercard con Paguelofacil (su enlace de pago: la tarjeta se
# escribe en su pagina, nunca en la nuestra). sandbox mueve dinero falso, live
# cobra de verdad; en produccion con sandbox el panel no arranca. El CCLW crea
# los enlaces y el TOKEN consulta las transacciones, que es lo que decide si
# alguien pago: sin los dos, la tarjeta sale como "pronto". El SECRETO va en la
# direccion del aviso automatico, que se pide a customerservice@paguelofacil.com
# apuntando a APP_BASE_URL/webhooks/paguelofacil/<secreto>.
PAGUELOFACIL_ENV=sandbox
PAGUELOFACIL_CCLW=
PAGUELOFACIL_TOKEN=
PAGUELOFACIL_WEBHOOK_SECRET=
# Solo si la pagina de pago resulta ser otra que la de siempre (la de sandbox no
# esta documentada). Ejemplo: https://checkout-sand.paguelofacil.com
PAGUELOFACIL_CHECKOUT=

YAPPY_MERCHANT_ID=
YAPPY_SECRET=
