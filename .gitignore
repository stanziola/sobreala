# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node (landing build tooling, si aplica)
node_modules/

# OS / editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Kits de marca de terceros (brand/social, brand/payments): solo se versionan
# los archivos que la web puede usar. Los originales de imprenta se quedan en
# el disco de quien los descargó.
brand/social/**/*.ai
brand/social/**/*.eps
brand/social/**/*.pdf
brand/social/**/*.jpg
brand/payments/**/*.ai
brand/payments/**/*.eps
brand/payments/**/*.pdf
brand/payments/**/*.jpg
# Lo que deja el Finder al comprimir un kit en una Mac: copias «._» sin nada útil.
__MACOSX/

# Correos guardados en desarrollo: llevan enlaces de confirmación válidos.
backend/.mail_outbox/

# Contexto de mercado: costos, márgenes por plan, precios de la competencia y
# prospectos. Nunca debe viajar con el repositorio. Los planes y precios
# públicos siguen en docs/pricing.md, que el sitio necesita para construirse.
docs/pricing-interno.md

# Variantes de los kits de marca que el sitio no usa y pesan de más.
# El glifo en degradado de Instagram son 13 MB: el SVG lleva un PNG incrustado.
# El sitio usa el glifo blanco, que pesa 1 KB. Los archivos siguen en tu disco.
brand/social/instagram/01 Gradient Glyph/

# Credenciales y claves, por si alguna vez caen en la carpeta del proyecto.
*.pem
*.key
*.p12
*.pfx
id_rsa*
.env.local
.env.*.local

# Configuración local del editor y de herramientas
.claude/settings.local.json
*.swp
*~

# Lo que se genera a pedido para revisarlo a mano: se queda en este disco, no en
# el repositorio.
entregas/
